<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-success text-white">
          <h4 class="mb-0">✓ Registration Successful!</h4>
        </div>
        <div class="card-body">
          <div class="text-center mb-4">
            <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
            <h3 class="mt-3">You are registered to the site!</h3>
            <p class="text-muted">Your account has been created successfully.</p>
          </div>
          
          <div class="card bg-light">
            <div class="card-header">
              <h5 class="mb-0">Your Information</h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <p><strong>Username:</strong></p>
                  <p class="text-muted" id="username">{{user.username}}</p>
                </div>
                <div class="col-md-6">
                  <p><strong>Email:</strong></p>
                  <p class="text-muted" id="email">{{user.email}}</p>
                </div>
              </div>
              <div class="row mt-3">
                <div class="col-md-6">
                  <p><strong>Registration Date:</strong></p>
                  <p class="text-muted" id="createdAt">{{user.createdAt}}</p>
                </div>
                <div class="col-md-6">
                  <p><strong>Login Method:</strong></p>
                  <p class="text-muted" id="loginMethod">{{loginMethod}}</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="text-center mt-4">
            <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
            <a href="/" class="btn btn-outline-secondary">Go to Home</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const userData = localStorage.getItem('user');
    const token = localStorage.getItem('token');
    
    if (userData) {
      const user = JSON.parse(userData);
      document.getElementById('username').textContent = user.username || '-';
      document.getElementById('email').textContent = user.email || '-';
    }
    
    if (token) {
      console.log('User registered successfully with token');
    }
  });
</script>
